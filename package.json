{
  "name": "zeta-docs",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check-docs": "node ./build/check-docs.js",
    "lint": "eslint build/*.js",
    "generate-sidebar": "node ./build/generate-sidebar.js",
    "serve": "npm run generate-sidebar && docsify serve .",
    "dev": "npm run serve",
    "build": "npm run generate-sidebar && node ./build/build-site.js",
    "test": "npm run build && node --test ./build/static-site.test.js",
    "verify": "npm run check-docs && npm run lint && npm run test"
  },
  "devDependencies": {
    "docsify-cli": "^4.4.4",
    "eslint": "9.39.4"
  }
}
